# ========== REQUIRED FOR TELEGRAM SIGNALS ==========
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_ADMIN_IDS=987654321
# Get your numeric ID from @userinfobot — comma-separate multiple IDs

# ========== DATABASE (required for Render production) ==========
# Local development only; Render must use a reachable managed PostgreSQL database.
DATABASE_URL=sqlite+aiosqlite:///./delta_signal_bot.db
# On Render, set DATABASE_URL to your PostgreSQL connection string:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/delta_signals

# ========== DELTA EXCHANGE INDIA (public market data; no API keys required) ==========
DELTA_REST_BASE=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# ========== APP ==========
APP_ENV=development
LOG_LEVEL=INFO
SIGNAL_THRESHOLD=7.0
CANDLE_PRIMARY_TF=5m
CANDLE_CONFIRM_TF=15m  # Normal 15m context is aggregated from complete 5m candles
CANDLE_CLOSE_GRACE_SECONDS=3
MAX_SIGNAL_AGE_SECONDS=120
NORMAL_SYMBOL_LIMIT=40
MOMENTUM_SYMBOL_LIMIT=100
MAX_CANDLES_BUFFER=300
ENABLE_WEBSOCKET=true
# Forming-candle ignition is diagnostic/watch-only by default; closed candles publish signals.
LIVE_IGNITION_MODE=shadow
LIVE_MIN_SCORE=8.0
ENABLE_NORMAL_ENGINE=true
ENABLE_MOMENTUM_ENGINE=true
MEMORY_WARNING_MB=400

# ========== NORMAL INDICATOR RULES ==========
NORMAL_ADX_MIN=25.0
# Normal Engine only: completed-candle volume / mean of prior 20 completed candles
# Optional Normal RVOL gate; disabled unless explicitly enabled.
NORMAL_RVOL_GATE_ENABLED=false
NORMAL_RVOL_MIN=1.4
# Momentum engine ADX threshold (detector-specific/diagnostic; independent from Normal)
MOMENTUM_ADX_MIN=20.0

# Fees, spread and slippage are deliberately not used as signal rejection gates.

# ========== CRYPTO SESSION ORB (completed 5m candles) ==========
# Every session builds its opening range from exactly one completed 5-minute candle.
# London and New York use IANA time zones; DST shifts are automatic.
ORB_ENABLED=true
ORB_ASIA_ENABLED=true
ORB_SYDNEY_ENABLED=true
ORB_CME_ENABLED=true
ORB_LONDON_ENABLED=true
ORB_NEW_YORK_ENABLED=true
ORB_LATE_US_ENABLED=false
ORB_MIN_RVOL=1.40
ORB_MAX_EXTENSION_ATR=0.80
ORB_ADX_MIN=20.0

# Signal-only safety is enforced in config.py; no order execution is available.
SIGNAL_ONLY=true
ORDERS_ENABLED=false
